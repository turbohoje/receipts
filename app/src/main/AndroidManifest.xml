<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Drive backup only. Nothing else in the app touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Picking an existing image uses the system photo picker, which needs no permission. -->

    <!--
      All optional: a device with no camera at all can still add receipts from the photo
      picker, so nothing here should keep the app off a device.

      android.hardware.camera must be listed explicitly. Requesting the CAMERA permission
      makes Google Play imply that feature as REQUIRED, and it means a rear-facing camera
      specifically — declaring only camera.any does not override it, because that is a
      different feature name. Left implied, it silently excludes every device without a
      back camera.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".ReceiptsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Receipts">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Receipts">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
