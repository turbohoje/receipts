# ---------- Build output ----------
# Matches app/build, and any future module's build dir.
build/
.gradle/
# Kotlin 2.x compiler session state
.kotlin/
# NDK
.cxx/
.externalNativeBuild/
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
*.jar
# ...but the Gradle wrapper jar MUST be committed, or ./gradlew cannot bootstrap.
!**/gradle/wrapper/gradle-wrapper.jar

# ---------- Machine-specific ----------
# SDK path differs per machine; local.properties.example is the committed template.
local.properties

# ---------- Secrets ----------
# Signing a release must never depend on anything in this repo.
keystore.properties
*.jks
*.keystore
# Google OAuth config. The app needs none of this — an Android OAuth client has no secret,
# and no client ID is embedded in the APK — but keep it out of the repo regardless.
google-services.json
client_secret*.json
*.p12
*.pepk

# ---------- Reports and logs ----------
lint-results*.html
lint-results*.xml
lint-results*.txt
*.log
captures/
.navigation/

# ---------- Swift / Xcode ----------
# SwiftPM build output. 142 MB and regenerated by `swift build`.
.build/
.swiftpm/
# Package.resolved is NOT ignored: it pins dependency versions and belongs in the repo.
# There are none today (the ZIP implementation is hand-rolled precisely so there are none).
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ---------- OS ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Device data dumps (contain real receipts)
device-backups/
